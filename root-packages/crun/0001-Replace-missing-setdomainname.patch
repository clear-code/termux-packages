From 6f497e6763f023a65520f551fa9fac3929ea7a90 Mon Sep 17 00:00:00 2001
From: Takuro Ashie <ashie@clear-code.com>
Date: Wed, 12 Mar 2025 15:58:22 +0900
Subject: [PATCH 1/3] Replace missing setdomainname

---
 src/libcrun/linux.c | 9 +++++++++
 1 file changed, 9 insertions(+)

diff --git a/src/libcrun/linux.c b/src/libcrun/linux.c
index af269e9b..81ec48cb 100644
--- a/src/libcrun/linux.c
+++ b/src/libcrun/linux.c
@@ -69,6 +69,11 @@
 #include <yajl/yajl_tree.h>
 #include <yajl/yajl_gen.h>
 
+#ifdef __ANDROID__
+#include <syscall.h>
+#include <asm/unistd.h> /* for __NR_setdomainname */
+#endif /* __ANDROID__ */
+
 #include "mount_flags.h"
 
 #define YAJL_STR(x) ((const unsigned char *) (x))
@@ -3329,7 +3334,11 @@ libcrun_set_domainname (libcrun_container_t *container, libcrun_error_t *err)
     return 0;
   if (! has_uts)
     return crun_make_error (err, 0, "domainname requires the UTS namespace");
+#ifdef __ANDROID__
+  syscall(__NR_setdomainname, def->domainname, strlen (def->domainname));
+#else /* __ANDROID__ */
   ret = setdomainname (def->domainname, strlen (def->domainname));
+#endif /* __ANDROID__ */
   if (UNLIKELY (ret < 0))
     return crun_make_error (err, errno, "setdomainname");
   return 0;
-- 
2.34.1

