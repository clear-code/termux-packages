 	list.c \
 	lockpw.c \
@@ -140,14 +138,12 @@ libshadow_la_SOURCES = \
 	pam_pass_non_interactive.c \
 	port.c \
 	port.h \
-	prefix_flag.c \
 	prototypes.h \
 	pwauth.c \
 	pwauth.h \
 	pwio.c \
 	pwio.h \
 	pwd_init.c \
-	pwd2spwd.c \
 	pwdcheck.c \
 	pwmem.c \
 	remove_tree.c \
@@ -169,7 +165,6 @@ libshadow_la_SOURCES = \
 	setupenv.c \
 	sgetgrent.c \
 	sgetpwent.c \
-	sgetspent.c \
 	sgroupio.c \
 	sgroupio.h\
 	shadow.c \
@@ -180,7 +175,6 @@ libshadow_la_SOURCES = \
 	shadowlog.c \
 	shadowlog.h \
 	shadowlog_internal.h \
-	shadowmem.c \
 	shell.c \
 	sizeof.h \
 	spawn.c \
@@ -253,7 +247,6 @@ libshadow_la_SOURCES = \
 	xgetpwuid.c \
 	xgetgrnam.c \
 	xgetgrgid.c \
-	xgetspnam.c \
 	yesno.c
 
 if WITH_TCB
diff --git a/lib/defines.h b/lib/defines.h
index 89300c93..69f96fef 100644
--- a/lib/defines.h
+++ b/lib/defines.h
@@ -50,7 +50,9 @@
 
