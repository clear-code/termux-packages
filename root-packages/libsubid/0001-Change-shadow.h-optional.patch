From a2ca5757ba3f0fce7d48ed108ede16940a80492e Mon Sep 17 00:00:00 2001
From: Kentaro Hayashi <hayashi@clear-code.com>
Date: Mon, 10 Mar 2025 14:45:47 +0900
Subject: [PATCH 1/3] Change shadow.h optional

Signed-off-by: Kentaro Hayashi <hayashi@clear-code.com>
---
 configure.ac      |  7 ++++++-
 lib/Makefile.am   |  7 -------
 lib/defines.h     |  2 ++
 lib/groupio.c     |  5 +++++
 lib/prefix_flag.c |  2 ++
 lib/prototypes.h  | 14 ++++++++++++++
 lib/pwdcheck.c    |  4 ++++
 lib/pwio.c        |  5 +++++
 lib/shadow.c      |  2 ++
 lib/shadowio.c    | 29 +++++++++++++++++++++++++++++
 lib/shadowio.h    |  6 ++++++
 11 files changed, 75 insertions(+), 8 deletions(-)

diff --git a/configure.ac b/configure.ac
index 36c57d8e..623a7eb9 100644
--- a/configure.ac
+++ b/configure.ac
@@ -37,7 +37,11 @@ LT_LIB_DLLOAD
 dnl Checks for libraries.
 
 dnl shadow now uses the libc's shadow implementation
-AC_CHECK_HEADER([shadow.h],,[AC_MSG_ERROR([You need a libc with shadow.h])])
+dnl AC_CHECK_HEADER([shadow.h],,[AC_MSG_ERROR([You need a libc with shadow.h])])
+AC_CHECK_HEADER([shadow.h],
+	[AC_DEFINE(HAVE_STRUCT_SPWD, 1, [Defined to 1 if you have struct spwd])],
+	[AC_MSG_WARN([No shadow.h for Android])]
+)
 
 AC_CHECK_FUNCS(arc4random_buf futimes \
 	getentropy getrandom getspnam getusershell \
@@ -62,6 +66,7 @@ dnl Checks for library functions.
 AC_FUNC_UTIME_NULL
 AC_REPLACE_FUNCS(putgrent putpwent putspent)
 AC_REPLACE_FUNCS(sgetgrent sgetpwent sgetspent)
+AC_REPLACE_FUNCS(l64a)
 
 AC_CHECK_FUNC(setpgrp)
 AC_CHECK_FUNC(secure_getenv, [AC_DEFINE(HAS_SECURE_GETENV,
diff --git a/lib/Makefile.am b/lib/Makefile.am
