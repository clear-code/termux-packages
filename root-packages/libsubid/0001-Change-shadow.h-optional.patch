+#if HAVE_SHADOW_H
 #include <shadow.h>
+#endif
 
 #include "attr.h"
 #include "prototypes.h"
@@ -20,6 +22,7 @@
 #include "pwauth.h"
 #include "shadowlog.h"
 
+#if HAVE_STRUCT_SPWD
