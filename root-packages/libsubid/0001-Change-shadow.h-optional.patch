 {
 	struct spwd *sp;
@@ -35,6 +38,7 @@ void passwd_check (const char *user, const char *passwd, MAYBE_UNUSED const char
 		exit (EXIT_FAILURE);
 	}
 }
+#endif
 #else			/* USE_PAM */
