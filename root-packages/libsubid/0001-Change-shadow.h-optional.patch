+#endif
 extern int spw_open (int mode);
 extern int spw_remove (const char *name);
 extern int spw_rewind (void);
 extern int spw_unlock (void);
+#if HAVE_STRUCT_SPWD
 extern int spw_update (const struct spwd *sp);
+#endif
 extern int spw_sort (void);
 
 #endif
