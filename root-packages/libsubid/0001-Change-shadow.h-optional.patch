 #endif
diff --git a/lib/groupio.c b/lib/groupio.c
index 516e3ccd..428ad5b2 100644
--- a/lib/groupio.c
+++ b/lib/groupio.c
@@ -79,7 +79,12 @@ static int group_put (const void *ent, FILE * file)
 		}
 	}
 
+#if HAVE_PUTRGRENT
 	return (putgrent (gr, file) == -1) ? -1 : 0;
+#else
+#warning "putgrent is not supported on Android"
+	return -1;
+#endif
 }
 
 static int group_close_hook (void)
diff --git a/lib/prefix_flag.c b/lib/prefix_flag.c
index c09b8d08..690cbe9b 100644
--- a/lib/prefix_flag.c
+++ b/lib/prefix_flag.c
@@ -248,6 +248,7 @@ extern int prefix_getpwnam_r(const char* name, struct passwd* pwd,
 	}
 }
 #endif
+#ifdef HAVE_STRUCT_SPDW
 extern struct spwd *prefix_getspnam(const char* name)
 {
 	if (spw_db_file) {
@@ -268,6 +269,7 @@ extern struct spwd *prefix_getspnam(const char* name)
 		return getspnam(name);
 	}
 }
+#endif
 
 extern void prefix_setpwent(void)
 {
diff --git a/lib/prototypes.h b/lib/prototypes.h
index 79bd0fdd..05283187 100644
