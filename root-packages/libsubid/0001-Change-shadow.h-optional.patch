 extern bool yes_or_no (bool read_only);
diff --git a/lib/pwdcheck.c b/lib/pwdcheck.c
index 5003d376..b37e17a1 100644
--- a/lib/pwdcheck.c
+++ b/lib/pwdcheck.c
@@ -12,7 +12,9 @@
